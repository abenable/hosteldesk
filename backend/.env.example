# Copy to .env (gitignored) — local development values only.
# Neon *pooled* connection string (…-pooler…).
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Exact-origin CORS allowlist, comma-separated.
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# Local Bun dev server port (dev.ts)
PORT=3000
