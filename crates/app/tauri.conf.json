{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostelDesk",
  "version": "1.0.0",
  "identifier": "com.hosteldesk.app",
  "build": {
    "beforeBuildCommand": {
      "cwd": "../../frontend",
      "script": "npm run build"
    },
    "beforeDevCommand": {
      "cwd": "../../frontend",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "HostelDesk",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Office",
    "publisher": "Able Abenaitwe",
    "copyright": "Copyright (c) 2026 Able Abenaitwe. All rights reserved.",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
