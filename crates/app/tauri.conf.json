{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostelDesk",
  "version": "0.1.0",
  "identifier": "com.hosteldesk.app",
  "build": {
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run build'",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/frontend\" && npm run dev'",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "HostelDesk",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
